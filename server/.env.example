# server/.env.example  (copy to server/.env and fill in; never commit .env)

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: pick a current Flash model name shown in AI Studio.
# If empty, the code uses the "gemini-flash-latest" alias.
GEMINI_MODEL=

PORT=5000
