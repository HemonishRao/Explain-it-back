# Copy to server/.env for local development. Keep API credentials server-side.

# Get a Gemini API key at https://aistudio.google.com/apikey and add it only
# to server/.env.
GEMINI_API_KEY=

# Optional: pick a current Flash model name shown in AI Studio.
# If empty, the code uses the "gemini-flash-latest" alias.
GEMINI_MODEL=

PORT=5000

# Optional: absolute path to a persistent SQLite file. The default is
# server/explain-it-back.sqlite. The parent directory must already exist.
DATABASE_PATH=

# Optional for a separately hosted frontend. Comma-separated exact origins.
# Leave empty when Express serves the frontend and API from the same origin.
CORS_ORIGIN=
